{
  "name": "h32_supervision",
  "baseline_config": "configs/baseline_s2_e2.json",
  "init_weight": "checkpoints/phase2_S2/neurotwin_tfm_pretrain/base_best.pt",
  "split_file": "data/subject_split_finetune.json",
  "checkpoint_root": "checkpoints/h32_runs",
  "results_root": "results/h32_runs",
  "shared": {
    "freeze_backbone_epochs": 0,
    "train_anchor_max_offset": 32,
    "eval_anchor_min_future_steps": 32,
    "eval_rollout_tasks_per_subject": 0,
    "dynamics_metric_horizon": 32,
    "batch_size": 64,
    "eval_batch_size": 128
  },
  "arms": {
    "h8": {
      "cpm_horizon": 8,
      "pretrained_horizon_policy": "require_match"
    },
    "h32": {
      "cpm_horizon": 32,
      "pretrained_horizon_policy": "repeat_last"
    }
  },
  "evaluation": {
    "primary": "metric_mae_dynamics_h1_32_subject",
    "segments": [
      [
        1,
        8
      ],
      [
        9,
        16
      ],
      [
        17,
        32
      ]
    ],
    "context_length": 64,
    "anchors_per_subject": 16,
    "note": "两臂共用完整 H32 锚点；先锚点内全 ROI/步数平均，再被试内平均，最后被试等权。主指标越低越好；H17–32 为重点远期分段。"
  }
}
