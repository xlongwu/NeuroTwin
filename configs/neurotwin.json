{
  "_meta": {
    "name": "neurotwin",
    "description": "固定结构：历史编码、功能图先验、个体 profile 与 Graph-ODE。当前阶段只训练/评估 H1–8，目标为重建、FC 与频域三项。",
    "status": "current",
    "notes": "预训练与微调分别使用 hc3/demo 和 mdd8/cat；保留训练随机种子、损失权重及优化参数。H9–32 与 CPM/方差辅助监督暂不启用；选模判据为 H1–8 被试级 MAE + FC MSE，FC 在 8 步未来序列上估计。"
  },
  "architecture": {
    "model_arch": "tfm",
    "task_mode": "next_timepoint",
    "num_rois": 116,
    "context_min": 16,
    "context_max": 64,
    "forecast_offsets": "1",
    "calibration_length": 32,
    "tfm_dim": 256,
    "tfm_layers": 4,
    "tfm_heads": 4,
    "tfm_ff_ratio": 4,
    "tfm_patch_len": 8,
    "tfm_one_step_hidden_dim": 256,
    "tfm_patho_mode": "film",
    "cpm_horizon": 8,
    "cpm_layers": 2,
    "cpm_intervention": false,
    "norm": true,
    "dropout": 0.1,
    "sc_prior_mode": "soft_prior",
    "sc_lambda_mode": "global",
    "sc_lambda_init": 0.7,
    "sc_prior_rank": 12,
    "sc_delta_a": true,
    "sc_delta_rank": null,
    "sc_sinkhorn_iters": 64,
    "dynamics_mode": "graph_ode",
    "ode_steps": 2,
    "dynamics_dt": 1.0,
    "graph_source": "history_fc",
    "personalized": true,
    "profile_dim": 32,
    "dynamics_history_memory": true
  },
  "loss": {
    "name": "h1_8_reconstruction_fc_frequency",
    "lambda_rec": 1.0,
    "lambda_fc": 1.0,
    "lambda_freq": 1.0,
    "loss_weighting": "uncertainty"
  },
  "data_and_split": {
    "data_root": "data/",
    "bold_source": "raw",
    "clinical_file": "Rest-meta-MDD-V1V2-Merged-MDD.xlsx",
    "val_ratio": 0.1,
    "test_ratio": 0.1,
    "split": "被试级 8:1:1，优先 split_file > 版本化 manifest（subject_split_<mode>.json）> 现场按模型 seed 生成；当前 manifest 记录 seed=2024",
    "conditioning": {
      "pretrain": {
        "condition_arm": "demo",
        "condition_group": "hc3"
      },
      "finetune": {
        "condition_arm": "cat",
        "condition_group": "mdd8"
      },
      "cond_inject": "heads",
      "cond_dim": 32,
      "cond_d_demo": 16,
      "cond_d_new": 16,
      "cond_h_delta": 64,
      "cond_delta_style": "mlp",
      "cond_dropout_p": 0.0
    }
  },
  "training": {
    "seed": 2024,
    "sampling_seed": 20261009,
    "cond_dropout_seed": 20261008,
    "split_seed": 2024,
    "batch_size": 128,
    "train_epochs": 30,
    "lr_init": 2e-05,
    "lr_peak": 5e-05,
    "lr_final": 1e-05,
    "warmup_epochs": 3,
    "weight_decay": 0.01,
    "grad_clip": 1.0,
    "patience": 12,
    "freeze_backbone_epochs": 10,
    "backbone_lr_scale": 0.2,
    "use_ema": true,
    "ema_decay": 0.999,
    "amp": true,
    "entrypoints": [
      "bash scripts/pretrain.sh",
      "bash scripts/finetune.sh"
    ]
  },
  "evaluation_protocol": {
    "primary": "val 选模 = H1–8 被试级 MAE + FC MSE（等权相加，越低越好）；test 报告单步 MAE、H1–8 MAE、FC PCC/MSE 与频域 L1",
    "final_eval": "python -m analysis.evaluate --ckpt checkpoints/h1_8_v2/neurotwin_finetune/finetuned_best.pt --out_dir results/evaluation --splits test",
    "metrics_reference": "main.evaluate_tfm"
  },
  "weights": {
    "pretrain": {
      "role": "hc_pretrain",
      "path": "checkpoints/h1_8_v2/neurotwin_pretrain/base_best.pt",
      "sha256": "041689f82ad205f41bad3c8d5d688c4d8818a87eb538fa3dfec870910ef961bc",
      "note": "2026-10-28 三损失 H1–8 重训（30 epoch 完整跑完）；val 联合判据 0.7865 = MAE 0.5424 + FC MSE 0.2442。"
    },
    "finetune": {
      "role": "mdd_finetune",
      "path": "checkpoints/h1_8_v2/neurotwin_finetune/finetuned_best.pt",
      "sha256": "f89f57026bb789b0fb8e131a8042e7f220b2e2e827521b988ff3398806ecf4ac",
      "arch_version": 6,
      "params_total": 6244019,
      "note": "2026-10-28 从 h1_8_v2 HC 权重重训（30 epoch；epoch 19 为联合判据 best，val 0.7857 = MAE 0.5363 + FC MSE 0.2493）；主干冻结 10 轮，解冻后早停计数重置。"
    }
  }
}
