{
  "_meta": {
    "name": "neurotwin",
    "status": "current",
    "description": "唯一正式方案 B：历史功能图引导 TFM 编码 + 字段条件 CPM，固定 K64 直接预测 H32；以已验证权重为准。"
  },
  "architecture": {
    "num_rois": 116,
    "context_min": 64,
    "context_max": 64,
    "forecast_offsets": "1",
    "calibration_length": 32,
    "tfm_dim": 256,
    "tfm_layers": 4,
    "tfm_heads": 4,
    "tfm_ff_ratio": 4,
    "tfm_patch_len": 8,
    "cpm_horizon": 32,
    "cpm_layers": 2,
    "norm": true,
    "dropout": 0.1,
    "sc_prior_mode": "soft_prior",
    "sc_lambda_mode": "global",
    "sc_lambda_init": 0.7,
    "sc_prior_rank": 12,
    "sc_delta_a": true,
    "sc_delta_rank": null,
    "sc_sinkhorn_iters": 64
  },
  "loss": {
    "lambda_rec": 1.0,
    "lambda_fc": 0.05,
    "lambda_freq": 0.05,
    "lambda_delta": 0.5,
    "lambda_corr": 0.1,
    "lambda_local_corr": 0.05,
    "huber_delta": 1.0
  },
  "data_and_split": {
    "data_root": "data/",
    "bold_source": "raw",
    "clinical_file": "Rest-meta-MDD-V1V2-Merged-MDD.xlsx",
    "val_ratio": 0.1,
    "test_ratio": 0.1,
    "conditioning": {
      "pretrain": {
        "condition_arm": "demo",
        "condition_group": "hc3"
      },
      "finetune": {
        "condition_arm": "cat",
        "condition_group": "mdd8"
      },
      "cond_dim": 32,
      "cond_d_demo": 16,
      "cond_d_new": 16,
      "cond_h_delta": 64,
      "cond_delta_style": "mlp",
      "cond_dropout_p": 0.0
    }
  },
  "training": {
    "seed": 2024,
    "sampling_seed": 20261009,
    "cond_dropout_seed": 20261008,
    "batch_size": 64,
    "train_epochs": 150,
    "lr_init": 2e-05,
    "lr_peak": 5e-05,
    "lr_final": 1e-05,
    "warmup_epochs": 3,
    "weight_decay": 0.01,
    "grad_clip": 1.0,
    "patience": 12,
    "freeze_backbone_epochs": 10,
    "backbone_lr_scale": 0.2,
    "use_ema": true,
    "ema_decay": 0.999,
    "amp": true,
    "checkpoint_dir": "checkpoints/方案B/训练",
    "random_context": false,
    "eval_context_length": 64,
    "eval_anchors_per_subject": 8,
    "selection_corr_weight": 0.05,
    "train_samples_per_subject": 8,
    "compile": false,
    "num_workers": 6,
    "num_threads": 4,
    "pin_memory": false,
    "persistent_workers": true,
    "prefetch_factor": 2,
    "eval_batch_size": 256,
    "subject_cache_size": 4096,
    "cache_in_memory": false,
    "random_cutoff": true,
    "stratify_bins": 5,
    "tf32": true
  },
  "evaluation_protocol": {
    "primary": "完整 H32 被试等权 MAE + 0.05*(1-Temporal PCC)，越低越好；保存完整和逐时距指标。",
    "aggregation": "先按锚点计算，再被试内平均，最后跨被试等权。",
    "results": {
      "pretrain": "checkpoints/全时距双分支_20261104_231429/B/健康评估",
      "finetune": "checkpoints/全时距双分支_20261104_231429/B/抑郁症评估"
    }
  },
